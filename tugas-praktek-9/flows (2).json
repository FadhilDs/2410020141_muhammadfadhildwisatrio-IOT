  {
    "id": "n_dash_tpl",
    "type": "template",
    "z": "t_iot",
    "name": "Halaman Dashboard",
    "field": "payload",
    "fieldType": "msg",
    "format": "html",
    "syntax": "plain",
    "template": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>IoT Dashboard - REST API</title>\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js\"></script>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }\n    body {\n      background: linear-gradient(135deg, #667eea, #764ba2);\n      min-height: 100vh; padding: 20px; color: #333;\n    }\n    .container { max-width: 1000px; margin: 0 auto; }\n    h1 { color: white; text-align: center; margin-bottom: 25px; font-size: 28px; }\n    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px; }\n    .card {\n      background: white; border-radius: 15px; padding: 25px;\n      box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n      text-align: center; transition: transform 0.2s;\n    }\n    .card:hover { transform: translateY(-5px); }\n    .card .label { font-size: 14px; color: #888; text-transform: uppercase; letter-spacing: 1px; }\n    .card .value { font-size: 42px; font-weight: bold; margin: 10px 0; color: #667eea; }\n    .card .unit { font-size: 18px; color: #aaa; }\n    .status-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; }\n    .status-online { background: #d4edda; color: #155724; }\n    .status-offline { background: #f8d7da; color: #721c24; }\n    .panel {\n      background: white; border-radius: 15px; padding: 25px;\n      box-shadow: 0 10px 30px rgba(0,0,0,0.2); margin-bottom: 25px;\n    }\n    .panel h2 { font-size: 18px; margin-bottom: 15px; color: #444; }\n    .controls { display: flex; gap: 15px; flex-wrap: wrap; }\n    .btn {\n      padding: 12px 30px; border: none; border-radius: 10px;\n      font-size: 15px; font-weight: 600; cursor: pointer;\n      transition: all 0.2s;\n    }\n    .btn-on { background: #28a745; color: white; }\n    .btn-on:hover { background: #218838; }\n    .btn-off { background: #dc3545; color: white; }\n    .btn-off:hover { background: #c82333; }\n    table { width: 100%; border-collapse: collapse; }\n    th, td { padding: 10px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }\n    th { background: #f8f9fa; color: #666; text-transform: uppercase; font-size: 12px; }\n    tr:hover td { background: #f9f9f9; }\n    #log {\n      background: #1e1e1e; color: #0f0; font-family: monospace;\n      padding: 15px; border-radius: 10px; max-height: 180px;\n      overflow-y: auto; font-size: 13px; line-height: 1.6;\n    }\n    #log .error { color: #f66; }\n    #log .info { color: #6af; }\n  </style>\n</head>\n<body>\n<div class=\"container\">\n  <h1>🌡️ IoT Dashboard — REST API</h1>\n  <div id=\"mode\" style=\"text-align:center;color:white;margin:-15px 0 20px;font-size:14px;\">Mode: menyambungkan...</div>\n\n  <!-- Banner peringatan suhu -->\n  <div id=\"alert-banner\" style=\"display:none;background:#dc3545;color:white;padding:15px;border-radius:12px;margin-bottom:20px;text-align:center;font-weight:600;box-shadow:0 10px 30px rgba(0,0,0,0.2);\"></div>\n\n  <!-- Kartu Sensor -->\n  <div class=\"cards\">\n    <div class=\"card\">\n      <div class=\"label\">Suhu</div>\n      <div class=\"value\" id=\"suhu\">--</div>\n      <div class=\"unit\">°C</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"label\">Kelembaban</div>\n      <div class=\"value\" id=\"kelembaban\">--</div>\n      <div class=\"unit\">%</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"label\">Status Sensor</div>\n      <div class=\"value\" style=\"font-size:22px;\" id=\"status\">\n        <span class=\"status-badge status-offline\" id=\"status-badge\">OFFLINE</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Threshold -->\n  <div class=\"panel\">\n    <h2>🚨 Batas Suhu (Threshold)</h2>\n    <div class=\"controls\">\n      <input type=\"number\" id=\"thr-input\" step=\"0.1\" placeholder=\"mis. 30\" style=\"padding:12px;border:1px solid #ccc;border-radius:10px;font-size:15px;width:140px;\">\n      <button class=\"btn btn-on\" onclick=\"setThreshold()\">Set Batas</button>\n      <span id=\"thr-now\" style=\"align-self:center;color:#666;\">Batas saat ini: --</span>\n    </div>\n  </div>\n\n  <!-- Kontrol -->\n  <div class=\"panel\">\n    <h2>💡 Kontrol Perangkat</h2>\n    <div class=\"controls\">\n      <button class=\"btn btn-on\" onclick=\"kontrol('lamp','on')\">Nyalakan Lampu</button>\n      <button class=\"btn btn-off\" onclick=\"kontrol('lamp','off')\">Matikan Lampu</button>\n    </div>\n  </div>\n\n  <!-- Grafik Real-time -->\n  <div class=\"panel\">\n    <h2>📈 Grafik Real-time</h2>\n    <div style=\"position:relative;height:300px;\">\n      <canvas id=\"chart\"></canvas>\n    </div>\n  </div>\n\n  <!-- History -->\n  <div class=\"panel\">\n    <h2>📊 10 Data Sensor Terakhir</h2>\n    <table>\n      <thead>\n        <tr><th>Waktu</th><th>Suhu (°C)</th><th>Kelembaban (%)</th></tr>\n      </thead>\n      <tbody id=\"history-body\">\n        <tr><td colspan=\"3\" style=\"text-align:center;color:#999;\">Loading...</td></tr>\n      </tbody>\n    </table>\n  </div>\n\n  <!-- Log -->\n  <div class=\"panel\">\n    <h2>📝 Log Aktivitas</h2>\n    <div id=\"log\"></div>\n  </div>\n</div>\n\n<script>\n// ==============================\n// KONFIGURASI\n// ==============================\n// Kalau dibuka dari Node-RED (http://localhost:1880/dashboard) pakai alamat relatif,\n// kalau dibuka sebagai file biasa pakai alamat lengkap.\nconst API_BASE = location.protocol.startsWith('http') ? '/api' : 'http://localhost:1880/api';\nconst API_KEY = 'rahasia123';   // harus sama dengan KEY di node \"Cek API Key\"\nconst HEADERS = { 'X-API-Key': API_KEY };\n\n// ==============================\n// UTILITY: LOG\n// ==============================\nfunction log(msg, type = 'info') {\n  const el = document.getElementById('log');\n  const time = new Date().toLocaleTimeString();\n  el.innerHTML += `<div class=\"${type}\">[${time}] ${msg}</div>`;\n  el.scrollTop = el.scrollHeight;\n}\n\n// ==============================\n// GRAFIK (Chart.js)\n// ==============================\nconst MAX_POINTS = 20;\nlet lastReceived = null;\n\nlet chart = null;\nif (typeof Chart !== 'undefined') {\n  chart = new Chart(document.getElementById('chart'), {\n  type: 'line',\n  data: {\n    labels: [],\n    datasets: [\n      { label: 'Suhu (°C)', data: [], borderColor: '#e74c3c', backgroundColor: 'rgba(231,76,60,0.1)', tension: 0.3, yAxisID: 'y' },\n      { label: 'Kelembaban (%)', data: [], borderColor: '#667eea', backgroundColor: 'rgba(102,126,234,0.1)', tension: 0.3, yAxisID: 'y1' }\n    ]\n  },\n  options: {\n    responsive: true,\n    maintainAspectRatio: false,\n    animation: false,\n    scales: {\n      y:  { position: 'left',  title: { display: true, text: 'Suhu (°C)' } },\n      y1: { position: 'right', title: { display: true, text: 'Kelembaban (%)' }, grid: { drawOnChartArea: false } }\n    }\n  }\n});\n} else {\n  // Chart.js gagal dimuat (internet mati/diblokir): bagian lain dashboard tetap jalan\n  document.getElementById('chart').parentElement.innerHTML =\n    '<p style=\"text-align:center;color:#c0392b;padding:40px 0;\">Grafik tidak tampil: Chart.js gagal dimuat (cek koneksi internet). Bagian lain dashboard tetap berfungsi.</p>';\n}\n\n// Isi grafik dari history supaya langsung berbentuk garis saat halaman dibuka\nlet chartSeeded = false;\nfunction seedChart(rows) {\n  if (!chart || chartSeeded || !rows.length) return;\n  chartSeeded = true;\n  const last = rows.slice(-MAX_POINTS);\n  chart.data.labels = last.map(d => new Date(d.received).toLocaleTimeString());\n  chart.data.datasets[0].data = last.map(d => d.suhu);\n  chart.data.datasets[1].data = last.map(d => d.kelembaban);\n  lastReceived = last[last.length - 1].received;\n  chart.update();\n}\n\nfunction updateChart(d) {\n  if (!chart) return;\n  // Hindari titik ganda kalau data belum berubah\n  if (d.received === lastReceived) return;\n  lastReceived = d.received;\n\n  chart.data.labels.push(new Date(d.received).toLocaleTimeString());\n  chart.data.datasets[0].data.push(d.suhu);\n  chart.data.datasets[1].data.push(d.kelembaban);\n\n  if (chart.data.labels.length > MAX_POINTS) {\n    chart.data.labels.shift();\n    chart.data.datasets.forEach(ds => ds.data.shift());\n  }\n  chart.update();\n}\n\n// ==============================\n// FETCH DATA SENSOR (GET)\n// ==============================\n// Tampilkan satu data sensor di kartu, grafik, dan banner\nfunction applySensor(d) {\n  document.getElementById('suhu').textContent = d.suhu;\n  document.getElementById('kelembaban').textContent = d.kelembaban;\n  updateChart(d);\n  checkAlert(d.suhu);\n  const badge = document.getElementById('status-badge');\n  badge.textContent = 'ONLINE';\n  badge.className = 'status-badge status-online';\n}\n\n// Ambil data lewat REST (dipakai saat awal dan sebagai cadangan polling)\nasync function fetchSensor() {\n  try {\n    const res = await fetch(`${API_BASE}/suhu`, { headers: HEADERS });\n    const json = await res.json();\n\n    if (json.status === 'success' && json.data.suhu !== null) {\n      applySensor(json.data);\n    } else {\n      if (json.status === 'error') log(`✗ ${json.message}`, 'error');\n      const badge = document.getElementById('status-badge');\n      badge.textContent = 'OFFLINE';\n      badge.className = 'status-badge status-offline';\n    }\n  } catch (err) {\n    log(`Gagal fetch sensor: ${err.message}`, 'error');\n  }\n}\n\n// ==============================\n// WEBSOCKET (update tanpa polling)\n// ==============================\nlet ws = null;\nlet pollTimer = null;\n\nfunction setMode(text) {\n  document.getElementById('mode').textContent = 'Mode: ' + text;\n}\nfunction startPolling() {\n  if (!pollTimer) pollTimer = setInterval(fetchSensor, 3000);\n}\nfunction stopPolling() {\n  clearInterval(pollTimer);\n  pollTimer = null;\n}\n\nfunction connectWS() {\n  const proto = location.protocol === 'https:' ? 'wss://' : 'ws://';\n  const host = location.protocol.startsWith('http') ? location.host : 'localhost:1880';\n  ws = new WebSocket(`${proto}${host}/ws/sensor`);\n\n  ws.onopen = () => {\n    log('✓ WebSocket tersambung (real-time)', 'info');\n    setMode('WebSocket (real-time, tanpa polling)');\n    stopPolling();\n  };\n\n  // \"Bel\": fungsi ini jalan otomatis setiap Node-RED mengirim data baru\n  ws.onmessage = (event) => {\n    try {\n      applySensor(JSON.parse(event.data));\n    } catch (err) {\n      log(`Data WebSocket tidak valid: ${err.message}`, 'error');\n    }\n  };\n\n  ws.onclose = () => {\n    log('WebSocket terputus, pakai polling cadangan dan coba sambung lagi...', 'error');\n    setMode('Polling (cadangan)');\n    startPolling();\n    setTimeout(connectWS, 3000);\n  };\n\n  ws.onerror = () => ws.close();\n}\n\n// ==============================\n// FETCH HISTORY\n// ==============================\nasync function fetchHistory() {\n  try {\n    const res = await fetch(`${API_BASE}/history`, { headers: HEADERS });\n    const json = await res.json();\n    const tbody = document.getElementById('history-body');\n\n    if (!json.data || json.data.length === 0) {\n      tbody.innerHTML = '<tr><td colspan=\"3\" style=\"text-align:center;color:#999;\">Belum ada data</td></tr>';\n      return;\n    }\n\n    // Ambil 10 terakhir, balik urutan (terbaru di atas)\n    const rows = json.data.slice(-10).reverse().map(d => `\n      <tr>\n        <td>${new Date(d.received).toLocaleTimeString()}</td>\n        <td>${d.suhu}</td>\n        <td>${d.kelembaban}</td>\n      </tr>\n    `).join('');\n    tbody.innerHTML = rows;\n    seedChart(json.data);\n  } catch (err) {\n    log(`Gagal fetch history: ${err.message}`, 'error');\n  }\n}\n\n// ==============================\n// KONTROL LAMPU (POST)\n// ==============================\nasync function kontrol(device, action) {\n  try {\n    const res = await fetch(`${API_BASE}/kontrol`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json', 'X-API-Key': API_KEY },\n      body: JSON.stringify({ device, action })\n    });\n    const json = await res.json();\n    if (json.status === 'success') {\n      log(`✓ Perintah terkirim: ${device} → ${action}`, 'info');\n    } else {\n      log(`✗ Gagal: ${json.message}`, 'error');\n    }\n  } catch (err) {\n    log(`✗ Error kontrol: ${err.message}`, 'error');\n  }\n}\n\n// ==============================\n// THRESHOLD (PUT) + PERINGATAN\n// ==============================\nlet currentThreshold = null;\n\nasync function loadThreshold() {\n  try {\n    const res = await fetch(`${API_BASE}/threshold`, { headers: HEADERS });\n    const json = await res.json();\n    if (json.status === 'success') {\n      currentThreshold = json.threshold;\n      document.getElementById('thr-now').textContent = `Batas saat ini: ${currentThreshold} °C`;\n    }\n  } catch (err) {\n    log(`Gagal ambil threshold: ${err.message}`, 'error');\n  }\n}\n\nasync function setThreshold() {\n  const v = parseFloat(document.getElementById('thr-input').value);\n  if (isNaN(v)) {\n    log('✗ Masukkan angka batas yang valid', 'error');\n    return;\n  }\n  try {\n    const res = await fetch(`${API_BASE}/threshold`, {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json', 'X-API-Key': API_KEY },\n      body: JSON.stringify({ max: v })\n    });\n    const json = await res.json();\n    if (json.status === 'success') {\n      log(`✓ Batas suhu diubah: ${json.threshold} °C`, 'info');\n      loadThreshold();\n    } else {\n      log(`✗ Gagal: ${json.message}`, 'error');\n    }\n  } catch (err) {\n    log(`✗ Error set threshold: ${err.message}`, 'error');\n  }\n}\n\nfunction checkAlert(suhu) {\n  const banner = document.getElementById('alert-banner');\n  if (currentThreshold !== null && suhu > currentThreshold) {\n    banner.textContent = `⚠️ Suhu ${suhu}°C melewati batas ${currentThreshold}°C`;\n    banner.style.display = 'block';\n  } else {\n    banner.style.display = 'none';\n  }\n}\n\n// ==============================\n// AUTO REFRESH\n// ==============================\nlog('Dashboard dimulai, menyambungkan WebSocket...');\nloadThreshold();\nfetchSensor();      // data awal lewat REST\nfetchHistory();\nconnectWS();        // selanjutnya data datang lewat WebSocket\nsetInterval(fetchHistory, 5000);\n</script>\n</body>\n</html>\n",
