  {
    "id": "n_thr_put_proc",
    "type": "function",
    "z": "t_iot",
    "name": "Simpan Threshold",
    "func": "var body = msg.payload || {};\nvar v = Number(body.max);\n\nif (body.max === undefined || body.max === null || body.max === '' || isNaN(v)) {\n    msg.statusCode = 400;\n    msg.payload = {status: 'error', message: 'field max wajib berupa angka'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return msg;\n}\n\nflow.set('threshold', v);\n\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diperbarui', threshold: v};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
    "outputs": 1,
