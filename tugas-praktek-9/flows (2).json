    "func": "var KEY = 'rahasia123';\nvar k = msg.req.headers['x-api-key'];\nif (k !== KEY) {\n    msg.statusCode = 401;\n    msg.payload = {status: 'error', message: 'API key tidak valid atau tidak ada'};\n    msg.headers = {'Access-Control-Allow-Origin': '*'};\n    return [null, msg];\n}\nreturn [msg, null];",
