    "y": 180,
    "wires": [
      [
        "n_store"
      ]
    ]
  },
  {
    "id": "n_store",
    "type": "function",
    "z": "t_iot",
    "name": "Simpan Data Sensor",
    "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\nflow.set('lastSensor', data);\n\n// history disimpan ke SQLite (node 'Siapkan INSERT')\n\n// cek batas suhu\nvar batas = flow.get('threshold');\nif (batas === undefined) batas = 30;\nif (data.suhu > batas) {\n    var alertMsg = {\n        topic: 'iot/alert',\n        payload: {\n            type: 'suhu_melewati_batas',\n            suhu: data.suhu,\n            batas: batas,\n            message: 'Suhu ' + data.suhu + ' C melewati batas ' + batas + ' C',\n            time: data.received\n        }\n    };\n    return [msg, alertMsg];\n}\nreturn [msg, null];",
    "outputs": 2,
    "x": 400,
    "y": 180,
    "wires": [
      [
        "n_dbg",
        "n_ws_out",
        "n_db_prep"
      ],
      [
        "n_alert_mqtt",
        "n_alert_dbg"
      ]
    ]
  },
  {
    "id": "n_dbg",
    "type": "debug",
    "z": "t_iot",
    "name": "Log Sensor",
    "active": true,
    "complete": "payload",
    "x": 640,
    "y": 160,
    "wires": []
  },
